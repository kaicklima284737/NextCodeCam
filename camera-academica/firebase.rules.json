{
  "rules": {
    "users": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" } },
    "groups": { "$code": {
      ".read": "auth != null",
      "$item": { ".write": "auth != null", ".validate": "newData.hasChildren(['title','folder','thumb','by','ts']) && newData.child('thumb').val().length < 400000" }
    } }
  }
}
